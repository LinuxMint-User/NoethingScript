{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NoethingScript",
  "scopeName": "source.noethingscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-definition" },
    { "include": "#call" },
    { "include": "#end-tag" },
    { "include": "#keywords" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block",
          "begin": "^[ \\t]*///[ \\t]*$",
          "end": "^[ \\t]*///[ \\t]*$"
        },
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "^[ \\t]*:([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function" }
          }
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "match": "\\b(call)\\s+([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.control" },
            "2": { "name": "entity.name.function" }
          }
        },
        {
          "match": "\\b(call)\\b",
          "captures": {
            "1": { "name": "keyword.control" }
          }
        }
      ]
    },
    "end-tag": {
      "patterns": [
        {
          "match": ":(end)\\b",
          "captures": {
            "1": { "name": "keyword.control" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(?:if|else|endif|for|endfor|while|endwhl|switch|case|default|endswc|break|continue|return|assert|endasrt|try|catch|endtry|jump|print|debug|arrfill|purge|all|except|copy)\\b"
        },
        {
          "name": "support.type",
          "match": "\\b(?:number|int|float|string|bool|array|void)\\b"
        },
        {
          "name": "storage.modifier",
          "match": "\\b(?:global|local|const|mut)\\b"
        },
        {
          "name": "support.class",
          "match": "\\b(Exception)\\b"
        },
        {
          "name": "constant.language",
          "match": "\\b(?:true|false|null|undefined)\\b"
        },
        {
          "name": "keyword.operator.arrow",
          "match": "->"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "(?<![\\w\\]\\x27\\x22])(?<!-> )(:)([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "punctuation.definition.label" },
            "2": { "name": "entity.name.label" }
          }
        }
      ]
    }
  }
}
