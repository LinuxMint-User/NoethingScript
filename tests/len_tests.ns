debug 0

// ========== 测试1: 数组长度 ==========
global array buffer[8]:int = arrfill
print len(buffer)

// ========== 测试2: 字符串长度 ==========
global str:string = "hello"
print len(str)

// ========== 测试3: len 在 for 循环条件中直接使用 ==========
global array data[3]:int = [10, 20, 30]
for (local i:int = 0; i < len(data); i = i + 1)
    print data[i]
endfor

// ========== 测试4: len 结果赋值给 int 变量 ==========
global size:int = 0
size = len(buffer)
print size

// ========== 测试5: len 的实参本身就是数组元素 ==========
global array a2[2]:string = ["123", "123456"]
print len(a2[1])

// 预期输出: 8, 5, 10, 20, 30, 8, 6
