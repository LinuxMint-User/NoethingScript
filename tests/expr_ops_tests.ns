debug 0

// ========== 测试1: >= 关系运算 ==========
global a:int = 5
if (a >= 5)
    print "ge true"
else
    print "ge false"
endif
if (a >= 6)
    print "bad ge"
else
    print "ge false ok"
endif
if (6 >= a)
    print "ge rev true"
endif

// ========== 测试2: 逻辑与 && (仅接受布尔操作数) ==========
if (a > 3 && a < 10)
    print "and true"
endif
if (a > 3 && a > 10)
    print "bad and"
else
    print "and false ok"
endif
try
    if (a && true)
        print "bad"
    endif
catch (Exception e1)
    print "caught and type: " + e1
endtry

// ========== 测试3: 逻辑或 || (仅接受布尔操作数) ==========
global flag:bool = false
if (flag || a == 5)
    print "or true"
endif
if (flag || a == 6)
    print "bad or"
else
    print "or false ok"
endif
try
    if (flag || a)
        print "bad"
    endif
catch (Exception e2)
    print "caught or type: " + e2
endtry

// ========== 测试4: 幂运算 ** (右结合) ==========
print 2 ** 3
print 2 ** 3 ** 2
print 3 ** 2 * 2
print 2 * 3 ** 2
global base:int = 2
print base ** 4

// ========== 测试5: 逻辑非 ! ==========
if (!false)
    print "not ok"
endif
if (!true)
    print "bad not"
else
    print "not false ok"
endif
print !(a == 5)

// ========== 测试6: 除法 / 与 除零异常 ==========
print 10 / 4
print 9 / 2
global dv:float = 7.0
print dv / 2
try
    print 1 / 0
catch (Exception e3)
    print "caught div0: " + e3
endtry

// ========== 测试7: 取模 % ==========
print 13 % 4
print a % 3

// ========== 测试8: 内置转换函数 int() / float() ==========
print int(3.7)
print int("42")
print float(2)
global fl:float = 0.0
fl = float(3)
print fl
print int(fl)

// ========== 测试9: 混合优先级与结合性 ==========
print 2 + 3 * 4
print (2 + 3) * 4
print 10 - 4 + 2
print 20 / 5 * 2
print 2 + 3 * 4 - 1
print -a + 10
print 0 - a

// ========== 测试10: 声明初始化字面量表达式 ==========
global initY:int = 3 + 4
print initY
global initS:string = "a" + "b"
print initS
global initF:float = 10 / 3
print initF
global initK:int = 2 * (3 + 4)
print initK
global initQ:string = "3+4"
print initQ
global array initA[3]:int = [1 + 2, 3 * 4, 10 / 2]
print initA[0]
print initA[1]
print initA[2]
global initFlag:bool = 1 < 2 && true
print initFlag

// ========== 测试11: 声明初始化禁止变量引用 (单变量/表达式) ==========
global initSrc:int = 1
try
    local initBadLocal:int = initSrc
catch (Exception e4)
    print "caught bad ref: " + e4
endtry
try
    local initBadExpr:int = initSrc + 4
catch (Exception e5)
    print "caught bad expr: " + e5
endtry
print "after init var checks"

// ========== 测试12: 隐式转换禁止 (2.7.2 收紧) ==========
// + 混合类型: 数字+布尔 / 字符串+数字 一律报错
global addBoolMix:int = 0
try
    addBoolMix = 5 + true
catch (Exception e6)
    print "caught add bool mix: " + e6
endtry
global addStrMix:string = ""
try
    addStrMix = "a" + 5
catch (Exception e7)
    print "caught add str mix: " + e7
endtry
// 合法路径: 数字+数字加法, 字符串+字符串拼接
print 5 + 3
print "a" + "b"
// 一元运算: + 仅数字, ! 仅布尔
global unPosBad:number = 0.0
try
    unPosBad = +"5"
catch (Exception e8)
    print "caught unpos: " + e8
endtry
global unNotBad:bool = false
try
    unNotBad = !0
catch (Exception e9)
    print "caught unnot: " + e9
endtry
print !true
// string 赋值收紧: 数字赋 string 报错 (赋值错误走 reportError, 输出后继续), 需 str() 显式转换
global strBad:string = "x"
strBad = 42
global strOk:string = "x"
strOk = str(42)
print strOk
// str/int/float 拒收布尔
global strBoolBad:string = "x"
try
    strBoolBad = str(true)
catch (Exception e11)
    print "caught str bool: " + e11
endtry
// 内置函数参数显式类型校验 (借用 JS 能力但不继承隐式强转: Math.*/Bit.* 只收 number, String.* 只收 string)
global mathAbsBad:int = 0
try
    mathAbsBad = Math.abs("5")
catch (Exception e12)
    print "caught math abs str: " + e12
endtry
global takeSrcBad:string = ""
try
    takeSrcBad = String.take(12345, 1, 2)
catch (Exception e13)
    print "caught take src: " + e13
endtry
global bitAndBad:int = 0
try
    bitAndBad = Bit.and("1", 2)
catch (Exception e14)
    print "caught bit and str: " + e14
endtry
print "after implicit ban"

// ========== 短路豁免: 内置函数 (函数模样的运算符) 可自由出现在 && / || 右侧 ==========
global scS:string = "hello"
global scFlag:bool = false
if (scFlag && len(scS) > 3)
    print "bad"
else
    print "rhs len ok"
endif
if (scFlag || str(5) == "5")
    print "rhs str ok"
endif
// 短路跳过右侧内置函数: Math.random() 不求值
if (true || Math.random() > 0.5)
    print "skip random ok"
endif
// 两侧正常求值时右侧内置函数仍执行
if (scFlag == false && len(scS) > 3)
    print "rhs executed"
endif
// input() 是唯一例外: 有副作用 (I/O), 禁止出现在短路右侧, 解析期报错可捕获
global scIn:bool = false
try
    if (scIn && input() == "y")
        print "bad"
    endif
catch (Exception e15)
    print "caught rhs input: " + e15
endtry

// ========== 测试13: 条件表达式必须布尔 (2.7.2 truthy 拒绝) ==========
// while 条件非布尔: 报错后跳过循环体 (拒绝 while (5) 静默进入)
while (5)
    print "bad while"
endwhl
print "after while"
// for 条件非布尔: 报错后跳过循环体
for (local fj:int = 0; 5; fj = fj + 1)
    print "bad for"
endfor
print "after for"
// assert 条件非布尔: 报错后跳过断言体
assert (5)
"should not show"
endasrt
print "after assert"
// jump 条件非布尔: 报错后不跳转
print "jump start"
jump (5): tt
print "bad jump"
:tt
print "jump ok"

