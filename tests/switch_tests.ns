debug 0
//global cnt:int = 0 
for (local cnt:int = 0; cnt < 5; cnt = cnt + 1)
switch (cnt)
case 0
print "case 0"
for (local cnt1:int = 0; cnt1 < 5; cnt1 = cnt1 + 1)
switch (cnt1)
case 0
print "nested case 0"
break
case 1
print "nested case 1"
break
default
print "nested default"
break
endswc
endfor
break
case 1
print "case 1"
break
default
print "default"
break
endswc
endfor

// 字符串 switch
// 预期: "matched b" 后无 break, fall-through 到 default 输出 "not default" (C风格语义)
:strSwitch () -> :void
switch ("b")
case "a"
print "not this"
case "b"
print "matched b"
default
print "not default"
endswc
:end
call strSwitch()

// 字符串 switch 不匹配时走 default
:strSwitch2 () -> :void
switch ("z")
case "a"
print "not this"
default
print "str default"
endswc
:end
call strSwitch2()

