debug 0

// ========== 测试1: 循环变量只读 (赋值报错, 可捕获) ==========
for (local i:int = 0; i < 3; i = i + 1)
    try
        i = 100
    catch (Exception e1)
        print "caught readonly: " + e1
    endtry
endfor

// ========== 测试2: 表达式 null 字面量 (可捕获) ==========
global x:int = 1
try
    if (x == null)
        print "impossible"
    endif
catch (Exception e2)
    print "caught null: " + e2
endtry

// ========== 测试3: 表达式 undefined 字面量 (可捕获) ==========
try
    if (x == undefined)
        print "impossible"
    endif
catch (Exception e3)
    print "caught undefined: " + e3
endtry

// ========== 测试4: 未定义变量使用 (ReferenceError, 可捕获) ==========
try
    print noSuchVar
catch (Exception e4)
    print "caught ref var: " + e4
endtry

// ========== 测试5: 断言失败被 try-catch 捕获 ==========
try
    assert (x == 2)
    "assertion failed"
    endasrt
catch (Exception e5)
    print "caught assert: " + e5
endtry

// ========== 测试6: 参数多于声明 → 取前 + 警告 ==========
:twoArg (a:int, b:int) -> sum:int
sum = a + b
return sum
:end

global r1:int = 0
call twoArg(1, 2, 999) -> r1
print r1

// ========== 测试7: 参数少于声明 → 报错并跳过调用 ==========
call twoArg(1) -> r1
print "after few args"

// ========== 测试8: 参数类型不匹配 → 报错并跳过调用 ==========
call twoArg("a", 2) -> r1
print "after bad type"

// ========== 测试9: 跨类型比较 (==) → 报错可捕获 (2.7.2, 类型不同不再返回 false) ==========
global sx:int = 0
global sy:string = "0"
try
    if (sx == sy)
        print "equal"
    endif
catch (Exception e9)
    print "caught type mismatch: " + e9
endtry

// ========== 测试10: 循环变量作用域内声明同名 → 报错, 循环继续 ==========
for (local k:int = 0; k < 2; k = k + 1)
    local k:int = 3
    print "loop body " + str(k)
endfor

// ========== 测试11: 多行注释就近闭合 (仅独占行 /// 作为标志, 中间行无需 /// 前缀) ==========
///
print "注释内, 不应输出"
print "也是注释内"
///
print "after comment"

// ========== 测试12: 未初始化变量声明 (值为 undefined, 使用报错可捕获) ==========
global uninitInt:int
try
    print uninitInt
catch (Exception e12)
    print "caught uninit var: " + e12
endtry

// ========== 测试13: 未初始化的返回值变量 → 返回 undefined, 使用报错 ==========
:noInit (a:int) -> out:int
return out
:end
global rr:int = 0
call noInit(1) -> rr
try
    print rr
catch (Exception e13)
    print "caught undef result: " + e13
endtry

// ========== 测试14: switch 非 int/string 条件 → 报错并跳过整个块 ==========
switch (1.5)
case 1
    print "case 1"
    break
default
    print "default"
    break
endswc
print "after switch float"

// 预期输出:
// caught readonly: 循环变量 i 是只读的, 禁止修改
// caught readonly: 循环变量 i 是只读的, 禁止修改
// caught readonly: 循环变量 i 是只读的, 禁止修改
// caught null: 表达式中出现 null 值, 不被允许
// caught undefined: 表达式中出现 undefined 值, 不被允许
// caught ref var: 未定义的变量 noSuchVar
// caught assert: assertion failed
// 传入函数 twoArg 的参数多于定义, 忽略多出的传入参数
// 3
// 传入函数 twoArg 的参数数量过少: 期望 2, 实际 1
// after few args
// 函数 twoArg 参数 1 类型错误
// after bad type
// caught type mismatch: == 两侧类型必须相同, 无法比较 number 与 string
// 循环变量 'k' 作用域内禁止声明同名变量
// loop body 0
// 循环变量 'k' 作用域内禁止声明同名变量
// loop body 1
// after comment
// caught uninit var: 变量 uninitInt 的值为 undefined, 不能被使用
// caught undef result: 变量 rr 的值为 undefined, 不能被使用
// switch语句的条件表达式只能是int或string类型, 数字必须为整数
// after switch float
