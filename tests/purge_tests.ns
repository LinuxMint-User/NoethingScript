debug 3
global var0:int = 0
global var1:string = ""
global var3:string = ""
var0 = 1
var1 = "hi"
var3 = "global var3"
:func () -> :void
local var3:int = 6
local var4:string = "hello"
print var3
print var4
purge all except var4
print var3
print var4
:end
//purge var4
call func()
purge global.var0
//checked purge all
//checked purge all except varname
//checked purge global vars

// ========== purge 函数外调用 → 报错并继续 ==========
purge var1
print "after purge outside"

// ========== purge all except 全局变量 → 报错 (程序终止) ==========
:fu2 () -> :void
    local loc:int = 1
    purge all except global.var1
:end
call fu2()