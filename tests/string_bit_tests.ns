debug 0

// ========== 测试1: String.* 字符串操作 ==========
global s:string = "Hello World"
print len(s)
print String.take(s, 0, 5)
print String.take(s, 6, len(s) - 6)
print String.findFirst(s, "World")
print String.findFirst(s, "zzz")
print String.findFirst(s, "o", 5)
print String.findLast(s, "o")
print String.findLast(s, "zzz")
print String.has(s, "lo W")
print String.has(s, "xyz")
print String.replace(s, "World", "NS")
print String.replace("a-b-c", "-", "+")
print String.replace("a-b-c", "-", "+", true)
print String.toUpper(s)
print String.toLower(s)
print String.trim("  padded  ")
print String.trim("no pad")

// 标准写法: 先 has 确认存在再 findFirst 取值 (doc 返回规范)
global pos:int = 0
if (String.has(s, "World"))
    pos = String.findFirst(s, "World")
endif
print pos

// ========== 测试2: Bit.* 位运算 ==========
global b:int = 0
b = Bit.and(0xF0, 0x3C)
print b
b = Bit.or(0xF0, 0x0F)
print b
b = Bit.xor(0xFF, 0x0F)
print b
b = Bit.not(0)
print b
b = Bit.shl(1, 8)
print b
b = Bit.shr(0xFF, 4)
print b

// 32 位有符号语义: 高位溢出变负
b = Bit.shl(0x40000000, 1)
print b
b = Bit.shr(-8, 1)
print b

// ========== 测试3: 表达式内嵌套使用 ==========
print len(s) + Bit.shl(1, 2)
print Bit.and(0b1100, 0b1010)
print Bit.or(Bit.shl(1, 4), 3)

// ========== 测试4: 参数个数错误可捕获 ==========
try
    print String.take(s, 0)
catch (Exception e1)
    print "caught take arg: " + e1
endtry

try
    print String.replace(s, "World")
catch (Exception e2)
    print "caught replace arg: " + e2
endtry

try
    print String.findFirst(s)
catch (Exception e3)
    print "caught findFirst arg: " + e3
endtry

try
    print Bit.and(1)
catch (Exception e4)
    print "caught bit arg: " + e4
endtry

// ========== 测试4b: 参数类型错误可捕获 (2.7.2 收紧: 借用 JS 能力但不继承隐式强转) ==========
// Math.* 只收 number (此前 Math.abs("-5")=5 静默强转)
try
    print Math.abs("5")
catch (Exception e9)
    print "caught abs str: " + e9
endtry
try
    print Math.pow("2", 3)
catch (Exception e10)
    print "caught pow str: " + e10
endtry
try
    print Math.max("3", 7)
catch (Exception e11)
    print "caught max str: " + e11
endtry

// String.* 源串/目标串只收 string, 数字参数只收 number (此前 String.take(12345,1,2)="23" 静默强转)
try
    print String.take(12345, 1, 2)
catch (Exception e12)
    print "caught take src: " + e12
endtry
try
    print String.take("abc", "1", 2)
catch (Exception e13)
    print "caught take start: " + e13
endtry
try
    print String.has(s, 5)
catch (Exception e14)
    print "caught has tgt: " + e14
endtry
try
    print String.findFirst(s, "o", "x")
catch (Exception e15)
    print "caught findFirst from: " + e15
endtry
try
    print String.replace(s, "World", 42)
catch (Exception e16)
    print "caught replace tgt: " + e16
endtry

// Bit.* 只收 number (此前 Bit.and("1", 2) 静默强转)
try
    print Bit.and("1", 2)
catch (Exception e17)
    print "caught and str: " + e17
endtry
try
    print Bit.shl(1, "2")
catch (Exception e18)
    print "caught shl str: " + e18
endtry

// ========== 测试5: take 边界全显式 (越界抛 RangeError 可捕获) ==========
// start 越界 (start >= len)
try
    print String.take("abc", 3, 1)
catch (Exception e5)
    print "caught take start: " + e5
endtry

// count 超出剩余长度 (count > len - start)
try
    print String.take("abc", 1, 3)
catch (Exception e6)
    print "caught take count: " + e6
endtry

// 负 start / 负 count
try
    print String.take("abc", -1, 1)
catch (Exception e7)
    print "caught take neg: " + e7
endtry

// count=0 返回空串 (合法)
print "[" + String.take("abc", 1, 0) + "]"

// replace 第 4 参类型错误 (必须 bool) 可捕获
try
    print String.replace("a-b", "-", "+", 1)
catch (Exception e8)
    print "caught replace alltype: " + e8
endtry

// 预期输出:
// 11
// Hello
// World
// 6
// false
// 7
// 7
// false
// true
// false
// Hello NS
// a+b-c
// a+b+c
// HELLO WORLD
// hello world
// padded
// no pad
// 6
// 48
// 255
// 240
// -1
// 256
// 15
// -2147483648
// -4
// 15
// 8
// 19
// caught take arg: String.take 需要 3 个参数
// caught replace arg: String.replace 需要 3 或 4 个参数
// caught findFirst arg: String.findFirst 需要 2 或 3 个参数
// caught bit arg: Bit.and 需要 2 个参数
// caught abs str: 函数 Math.abs 参数 1 需要 number 类型, 实际是 string
// caught pow str: 函数 Math.pow 参数 1 需要 number 类型, 实际是 string
// caught max str: 函数 Math.max 参数 1 需要 number 类型, 实际是 string
// caught take src: 函数 String.take 参数 1 需要 string 类型, 实际是 number
// caught take start: 函数 String.take 参数 2 需要 number 类型, 实际是 string
// caught has tgt: 函数 String.has 参数 2 需要 string 类型, 实际是 number
// caught findFirst from: 函数 String.findFirst 参数 3 需要 number 类型, 实际是 string
// caught replace tgt: 函数 String.replace 参数 3 需要 string 类型, 实际是 number
// caught and str: 函数 Bit.and 参数 1 需要 number 类型, 实际是 string
// caught shl str: 函数 Bit.shl 参数 2 需要 number 类型, 实际是 string
// caught take start: 字符串越界: String.take start=3 count=1 超出长度 3
// caught take count: 字符串越界: String.take start=1 count=3 超出长度 3
// caught take neg: 字符串越界: String.take start=-1 count=1 超出长度 3
// []
// caught replace alltype: 函数 String.replace 参数 4 类型错误
