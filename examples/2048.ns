// ============================================================
//  NoethingScript 版 2048
//  玩法: 输入 w/a/s/d 移动方块, q 退出
//  相同数字碰撞合并, 目标是合出 2048
//  运行: node dist/noethingScript-Interpreter.js examples/2048.ns
// ============================================================

global array grid[16]:int = arrfill
global score:int = 0
global over:int = 0

// ------------------------------------------------------------
// 滑动合并: mode 0=左 1=右 2=上 3=下
// 直接修改传入的 grid, 返回本方向是否发生了移动
// ------------------------------------------------------------
:slideDir (mut g[]:int, mode:int) -> changed:int
local i:int
local j:int
local line:int
local sr:int
local sc:int
local w:int
local array row[4]:int = arrfill
local array res[4]:int = arrfill
changed = 0
line = 0
while (line < 4)
    // 提取该行/列到 row (按方向决定取源顺序)
    i = 0
    while (i < 4)
        res[i] = 0
        row[i] = 0
        i = i + 1
    endwhl
    i = 0
    while (i < 4)
        if (mode == 0)
            sr = line
            sc = i
        else
            if (mode == 1)
                sr = line
                sc = 3 - i
            else
                if (mode == 2)
                    sr = i
                    sc = line
                else
                    sr = 3 - i
                    sc = line
                endif
            endif
        endif
        row[i] = g[sr * 4 + sc]
        i = i + 1
    endwhl
    // 压缩: 非零靠前 (res 初始全 0, 其余位置自然为 0)
    w = 0
    i = 0
    while (i < 4)
        if (row[i] != 0)
            res[w] = row[i]
            w = w + 1
        endif
        i = i + 1
    endwhl
    // 合并: 相邻相同翻倍, 后面的前移
    i = 0
    while (i < 3)
        if (res[i] != 0 && res[i] == res[i + 1])
            res[i] = res[i] * 2
            score = score + res[i]
            j = i + 1
            while (j < 3)
                res[j] = res[j + 1]
                j = j + 1
            endwhl
            res[3] = 0
        endif
        i = i + 1
    endwhl
    // 写回并按原方向放回
    i = 0
    while (i < 4)
        if (mode == 0)
            sr = line
            sc = i
        else
            if (mode == 1)
                sr = line
                sc = 3 - i
            else
                if (mode == 2)
                    sr = i
                    sc = line
                else
                    sr = 3 - i
                    sc = line
                endif
            endif
        endif
        if (res[i] != g[sr * 4 + sc])
            changed = 1
        endif
        g[sr * 4 + sc] = res[i]
        i = i + 1
    endwhl
    line = line + 1
endwhl
return changed
:end

// ------------------------------------------------------------
// 在随机空位生成新方块 (90% 为 2, 10% 为 4)
// ------------------------------------------------------------
:spawnTile () -> :void
local n:int = 0
local k:int = 0
local idx:int = 0
local i:int = 0
// 数空位
i = 0
while (i < 16)
    if (grid[i] == 0)
        n = n + 1
    endif
    i = i + 1
endwhl
if (n > 0)
    k = int(Math.random() * n)
    i = 0
    while (i < 16)
        if (grid[i] == 0)
            if (idx == k)
                grid[i] = 2
                if (Math.random() < 0.1)
                    grid[i] = 4
                endif
                idx = idx + 1
            else
                idx = idx + 1
            endif
        endif
        i = i + 1
    endwhl
endif
:end

// ------------------------------------------------------------
// 打印棋盘
// ------------------------------------------------------------
:printGrid () -> :void
local r:int = 0
local c:int = 0
local v:int = 0
local line:string
r = 0
while (r < 4)
    line = ""
    c = 0
    while (c < 4)
        v = grid[r * 4 + c]
        if (v == 0)
            line = line + ".  "
        else
            line = line + str(v)
            if (v < 10)
                line = line + "  "
            else
                if (v < 100)
                    line = line + " "
                else
                    line = line + " "
                endif
            endif
        endif
        c = c + 1
    endwhl
    print line
    r = r + 1
endwhl
:end

// ------------------------------------------------------------
// 是否还有可行移动 (存在空位或有相邻相同方块)
// ------------------------------------------------------------
:hasMove () -> can:int
local i:int = 0
local r:int = 0
local c:int = 0
can = 0
i = 0
while (i < 16)
    if (grid[i] == 0)
        can = 1
    endif
    i = i + 1
endwhl
if (can == 0)
    r = 0
    while (r < 4 && can == 0)
        c = 0
        while (c < 4 && can == 0)
            if (c < 3)
                if (grid[r * 4 + c] == grid[r * 4 + c + 1])
                    can = 1
                endif
            endif
            if (r < 3)
                if (grid[r * 4 + c] == grid[(r + 1) * 4 + c])
                    can = 1
                endif
            endif
            c = c + 1
        endwhl
        r = r + 1
    endwhl
endif
return can
:end

// ==================== 主流程 ====================
call spawnTile()
call spawnTile()

global key:string
global ch:int
global canMove:int
while (over == 0)
    call printGrid()
    print "==== 分数: " + str(score) + " ===="
    print "移动: w/a/s/d, 退出: q"
    key = input()
    ch = 0
    if (key == "w")
        call slideDir(mut grid, 2) -> ch
    else
        if (key == "a")
            call slideDir(mut grid, 0) -> ch
        else
            if (key == "s")
                call slideDir(mut grid, 3) -> ch
            else
                if (key == "d")
                    call slideDir(mut grid, 1) -> ch
                else
                    if (key == "q")
                        over = 2
                    else
                        print "无效输入, 请按 w/a/s/d 或 q"
                    endif
                endif
            endif
        endif
    endif
    call hasMove() -> canMove
    if (canMove == 0)
        print "棋盘满了, 没有可移动的方块!"
        over = 1
    else
        if (ch == 1)
            call spawnTile()
        endif
    endif
endwhl
if (over == 2)
    print "已退出游戏"
else
    call printGrid()
    print "==== 游戏结束, 最终分数: " + str(score) + " ===="
endif
